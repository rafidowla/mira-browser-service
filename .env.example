PORT=3001
MIRA_API_TOKEN=change-this-to-a-random-secret
MAX_PROFILES=5
LOG_LEVEL=info

# Active hours (OPTIONAL) — the window (in THIS MACHINE's local time, 0-24,
# start < end) during which MIRA is allowed to run LinkedIn automation.
# MIRA runs entirely on your own computer, so this is YOUR local daytime —
# no need to coordinate across timezones with anyone else running MIRA.
# Unset = defaults to 8-20 (8am-8pm).
# MIRA_ACTIVE_HOURS_START=8
# MIRA_ACTIVE_HOURS_END=20

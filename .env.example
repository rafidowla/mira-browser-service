PORT=3001
MIRA_API_TOKEN=change-this-to-a-random-secret
MAX_PROFILES=5
LOG_LEVEL=info

# Active hours — the window (in THIS MACHINE's local time, 0-24, start < end)
# during which MIRA is allowed to run LinkedIn automation. MIRA runs entirely
# on your own computer, so this is YOUR local daytime — no need to coordinate
# across timezones with anyone else running MIRA. Shipped uncommented (not as
# a "# Unset = default" comment) on purpose: a commented-out default looks
# editable but silently does nothing until the leading # is also removed —
# confirmed live 2026-07-09 when a pilot tester changed the numbers but left
# the # in place and the change had no effect. Change the numbers directly;
# no need to touch anything else.
MIRA_ACTIVE_HOURS_START=8
MIRA_ACTIVE_HOURS_END=20

# Test mode — relaxes MIRA's bot-pacing so you can actually test.
# Normally MIRA paces itself like a human: it closes the browser after a
# handful of actions and then waits 1.5-4 hours before starting a new session,
# and only runs during daytime hours. That's great for a real account, but it
# makes a disposable TEST account impossible to iterate on (you get locked out
# mid-test with "next session available around ...").
# With MIRA_TEST_MODE=true, those waits are removed so you can connect, scan,
# and retry freely. Use this ONLY on a throwaway test account — set it to
# false (or delete the line) before ever using your real LinkedIn account.
MIRA_TEST_MODE=true
